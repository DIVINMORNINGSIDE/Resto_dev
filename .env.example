# Supabase : Project Settings > API (ou `npx supabase status` en local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# URL publique du site, utilisée dans les emails (laisser vide en local)
NEXT_PUBLIC_SITE_URL=
# Notifications (Web Push) : générer une paire avec `npx web-push generate-vapid-keys`.
# La clé privée reste secrète (jamais préfixée NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:divinmdiv@gmail.com
